@model intapscamis.camis.domain.LandBank.LandBankFacadeModel.SplitTaskList

    @if (Model.tasks.Count == 0)
    {
        <div class="text-center">
            <img style="max-width: 100%;" src="/images/no_data_found.jpg" alt="no resource found"/>
            <p style="text-align: center; color: #FF7700">There is no CAMIS QGIS tasks found...</p>
        </div>
    
    }
    else
    {
    <div class="table-responsive current-task">
        <table class="table table-striped table-bordered" style="font-size: 10pt">
            <thead>
            <tr>
                <th class="text-center">Action</th>
                <th class="text-center">UPIN</th>
                <th class="text-center">Split_In_To</th>
                <th class="text-center">Description</th>
            </tr>
            </thead>
            <tbody >
            @foreach(var task in Model.tasks)
            {
            <tr>
                <td>
                    
                        <input type="button" onclick="loadTask('@task.id',@task.n,'@task.upin')" value="@(task.pending ? " Process" : "Redo")" class="btn btn-md btn-secondary"/>
                        <input type="button" class="btn btn-md btn-warning" value="Reject" onclick="rejectTask2('@task.id')"/>
                        
                </td>
                <td>@task.upin</td>
                <td class="text-center">@task.n</td>
                <td>@task.description</td>

            </tr>
            }
            </tbody>
        </table>
    </div>
    }
