@model intapscamis.camis.domain.LandBank.LandBankFacadeModel.SplitData
<p style="font-size: 12pt;  width: 100%; border-bottom: 2px solid #00FF00"><strong>Original Parcel</strong></p>
<ul style="font-size: 10pt; list-style-type: square">
    <li><label>UPIN: </label> @Model.upin</li>
    <li><label>Area: </label> @Model.area</li>
    <li><label>Split in to: </label> @Model.n  parts</li>
</ul>
<hr>
<div id="split_parcels_list" style="margin-top: 15px;">
    <p style="font-size: 12pt; width: 100%; border-bottom: 2px solid #00FF00"><strong>Split Parcels</strong></p>
    <ul id="split_parcels_items" style="font-size: 10pt; list-style-type: square;">
        <li><em>Loading...</em></li>
    </ul>
</div>
<div class="align-right p-3" >
    <input id="split_button_commit" style="display:none" class="btn btn-md btn-secondary" type="button" value="Commit for Approval" onclick="split_comit()" />
    <input type="button" class="btn btn-md btn-warning" value="Reject" onclick="rejectTask()"/>
    <input id="split_button_cancel" type="button" class="btn btn-md btn-danger" value="Cancel" onclick="split_cancel()" />
</div>
