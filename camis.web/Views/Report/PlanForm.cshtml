@using intapscamis.camis.domain.Report.Models
@model intapscamis.camis.domain.Report.Models.PlanViewModel
@{ 
    var status = new[] { "", "Active", "Inactive", "Completed" };
}
@*
    For more information on enabling MVC for empty projects, visit http://go.microsoft.com/fwlink/?LinkID=397860
*@
<html xmlns="http://www.w3.org/1999/xhtml">
<head>
    <title>Progress Report Paper Form</title>
    <link rel="stylesheet" href="/style/bootstrap.min.css" />
    <script>
        window.addEventListener('load', () => window.print())
    </script>
</head>
<body>
    <h2>@Model.RootActivity.Activity.Name</h2>
    <p>Date :____________________</p>
    <p>Status : @status[(int)Model.Plan.StatusId]</p>

    <h3>Progress Report</h3>

    <div class="row">
        <div class="col-md-6">
            <table class="table table-bordered">
                <thead>
                    <tr>
                        <th style="text-align: left">Activity</th>
                        <th style="text-align: left">Variables</th>
                        <th style="text-align: left">Targets</th>
                    </tr>
                </thead>
                <tbody>
                @{
                    var rootChildren = Model.Hierarchy[Model.RootActivity].OrderBy(m => m.Activity.Id);
                }
                @foreach (var item in rootChildren)
                {
                    var model = new PlanNodePartialModel
                    {
                        Node = item,
                        Hierarchy = Model.Hierarchy,
                        IndentLevel = 0
                    };
                    @await Html.PartialAsync("PlanNode", model)
                }
                </tbody>
            </table>
        </div>
    </div>
    <div style="display: flex; padding: 5px 0 0">
        <div style="flex: 2">
            <p>Prepared by: ___________</p>
            <p>Date: ______________</p>
        </div>
        <div style="flex: 1">
            <p>Checked by: ______________</p>
            <p>Date: ______________</p>
        </div>
    </div>
</body>
</html>