<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <TypeScriptCompileBlocked>true</TypeScriptCompileBlocked>
    <TypeScriptToolsVersion>Latest</TypeScriptToolsVersion>
    <IsPackable>false</IsPackable>
    <SpaRoot>ClientApp\</SpaRoot>
    <DefaultItemExcludes>$(DefaultItemExcludes);$(SpaRoot)node_modules\**</DefaultItemExcludes>

    <!-- Set this to true if you enable server-side prerendering -->
    <BuildServerSideRenderer>false</BuildServerSideRenderer>
    <AssemblyName>intapscamis.camis</AssemblyName>
    <RootNamespace>intapscamis.camis</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.SpaServices.Extensions" Version="8.0.4" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="8.0.4" />
    <PackageReference Include="Microsoft.ApplicationInsights.AspNetCore" Version="2.21.0" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.NewtonsoftJson" Version="8.0.4" />
  </ItemGroup>

  <!-- SPA source files: exclude from publishing but show in project -->
  <ItemGroup>
    <Content Remove="$(SpaRoot)**" />
    <None Include="$(SpaRoot)**" Exclude="$(SpaRoot)node_modules\**" />
    <None Remove="ClientApp\.idea\**" />
    <Content Remove="ClientApp\.idea\**" />
    <None Remove="ClientApp\dist\**" />
    <Content Remove="ClientApp\dist\**" />
  </ItemGroup>

  <!-- Static assets (no need to copy to output, web root serves from source) -->
  <ItemGroup>
    <None Include="wwwroot\images\**\*" />
    <None Include="wwwroot\scss\**\*" />
    <None Include="wwwroot\cmss\process_split.js" />
  </ItemGroup>

  <!-- Project references -->
  <ItemGroup>
    <ProjectReference Include="..\camis.domain\camis.domain.csproj" />
    <ProjectReference Include="..\camis.reportviews\camis.reportviews.csproj" />
  </ItemGroup>

  <!-- Exclude build outputs and temp files -->
  <ItemGroup>
    <Compile Remove="ClientApp\.idea\**" />
    <Compile Remove="ClientApp\dist\**" />
    <EmbeddedResource Remove="ClientApp\.idea\**" />
    <EmbeddedResource Remove="ClientApp\dist\**" />
    <DistFiles Remove="ClientApp\dist\**" />
  </ItemGroup>

  <!-- This is the key: update existing Content items (Razor views) to copy to output -->
  <ItemGroup>
    <Content Update="Views\**\*.cshtml" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- Remove some automatically included patterns that cause warnings (optional) -->
  <ItemGroup>
    <_ContentIncludedByDefault Remove="ClientApp\dist\**" />
    <_ContentIncludedByDefault Remove="ClientApp\src\assets\data\**" />
    <_ContentIncludedByDefault Remove="wwwroot\fonts\**" />
    <_ContentIncludedByDefault Remove="wwwroot\js\**" />
  </ItemGroup>

  <!-- Node.js environment for SPA build (unchanged) -->
  <Target Name="DebugEnsureNodeEnv" BeforeTargets="Build" Condition=" '$(Configuration)' == 'Debug' And !Exists('$(SpaRoot)node_modules') ">
    <Exec Command="node --version" ContinueOnError="true">
      <Output TaskParameter="ExitCode" PropertyName="ErrorCode" />
    </Exec>
    <Error Condition="'$(ErrorCode)' != '0'" Text="Node.js is required to build and run this project. To continue, please install Node.js from https://nodejs.org/, and then restart your command prompt or IDE." />
    <Message Importance="high" Text="Restoring dependencies using 'npm'. This may take several minutes..." />
    <Exec WorkingDirectory="$(SpaRoot)" Command="npm install" />
  </Target>

  <Target Name="PublishRunWebpack" AfterTargets="ComputeFilesToPublish">
    <Exec WorkingDirectory="$(SpaRoot)" Command="npm install" />
    <Exec WorkingDirectory="$(SpaRoot)" Command="npm run build:production" />
    <Exec WorkingDirectory="$(SpaRoot)" Command="npm run build:ssr:production" Condition=" '$(BuildServerSideRenderer)' == 'true' " />
    <ItemGroup>
      <DistFiles Include="$(SpaRoot)dist\**; $(SpaRoot)dist-server\**" />
      <DistFiles Include="$(SpaRoot)node_modules\**" Condition="'$(BuildServerSideRenderer)' == 'true'" />
      <ResolvedFileToPublish Include="@(DistFiles->'%(FullPath)')" Exclude="@(ResolvedFileToPublish)">
        <RelativePath>%(DistFiles.Identity)</RelativePath>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      </ResolvedFileToPublish>
    </ItemGroup>
  </Target>

</Project>